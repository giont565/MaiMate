{
  "name": "maimate",
  "private": true,
  "description": "MaiMate 開發輔助腳本：前端煙測＋開發手冊重出（提案簡報 deck 的重依賴 sharp/react 仍在 docs/ 暫裝）",
  "scripts": {
    "test": "npm run test:backend && npm run test:python && npm run smoke",
    "test:backend": "python3 scripts/test_backend.py",
    "test:python": "python3 -m unittest discover -s tests -v",
    "validate:sam": "sam validate --template-file infra/template.yaml --lint",
    "build:sam": "sam build --template-file infra/template.yaml",
    "smoke": "node scripts/smoke_frontend.js",
    "handbook": "node docs/build_handbook.js"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "pptxgenjs": "^4.0.1"
  }
}
