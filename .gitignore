data/MaiCoin_*.csv
data/*.zip

# 金鑰與本地設定
.env
*.pem
samconfig.toml

# 本地快照與文件成品不進版控（放 Drive；程式碼走分支＋PR——workflow.md git 紀律）
/*.zip
/*.docx

# 建置產物（docs 簡報產生器的暫用 npm 檔勿入 git；根目錄 package.json 是煙測用、要進版控）
node_modules/
docs/**/package.json
docs/**/package-lock.json
__pycache__/
*.pyc
.aws-sam/
docs/*.pdf
docs/slide-*.jpg
.DS_Store
smoke_*.png

